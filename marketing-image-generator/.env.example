# ====================================================================
# Marketing Image Studio - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# Note: You can also configure these settings directly from the Admin UI!
# ====================================================================

# OpenRouter API Key (Required to generate images)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base Endpoint URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/images

# Default Image Model
OPENROUTER_DEFAULT_MODEL=recraft/recraft-v4.1-flash-v2:free

# Site Name & URL for OpenRouter Telemetry / Ranking Headers
OPENROUTER_SITE_NAME="Marketing Image Studio"
OPENROUTER_SITE_URL=http://localhost/AI-Image-Generator/marketing-image-generator

# Request Timeout in Seconds
OPENROUTER_TIMEOUT=120

# Database Configuration (MySQL / XAMPP)
DB_HOST=localhost
DB_NAME=marketing_ai_db
DB_USER=root
DB_PASS=
